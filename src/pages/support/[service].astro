---
import { supportServices } from '../../data/support-services';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return supportServices.map((service) => ({
    params: { service: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<BaseLayout
  title={`${service.name} | 北京盛博润通讯设备有限公司`}
  description={`${service.name}页面将在后续阶段完成。`}
  canonicalPath={service.href}
  breadcrumbs={[
    { label: '技术支持', href: '/support/' },
    { label: service.name, href: service.href },
  ]}
>
  <section class="foundation-placeholder site-container">
    <div>
      <h1>{service.name}</h1>
      <p>页面将在后续阶段完成。</p>
    </div>
  </section>
</BaseLayout>
