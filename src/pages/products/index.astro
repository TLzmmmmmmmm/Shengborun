---
import CategoryOverviewCard from '../../components/products/CategoryOverviewCard.astro';
import { getProductCategoryOverview } from '../../data/product-category-overview';
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = '产品中心';
const pageDescription = '专业的通信设备与解决方案，助力客户高效连接世界';
const productCategoryOverview = await getProductCategoryOverview();
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/products/"
  breadcrumbs={[{ label: '产品中心', href: '/products/' }]}
>
  <div class="products-page">
    <div class="products-content site-container">
      <section class="products-intro" data-products-intro>
        <h1>产品中心</h1>
        <p>{pageDescription}</p>
      </section>

      <section class="category-grid" aria-label="产品分类">
        {
          productCategoryOverview.map((category) => (
            <CategoryOverviewCard {...category} />
          ))
        }
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .products-page {
    min-height: 100vh;
    background: var(--surface-muted);
  }

  .products-content {
    max-width: 100rem;
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .products-intro {
    padding-block: clamp(2rem, 4vh, 2.75rem) clamp(2rem, 4.5vh, 2.75rem);
    text-align: center;
  }

  h1 {
    margin: 0;
    color: var(--brand-graphite);
    font-size: clamp(1.75rem, 2.4vw, 2.25rem);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .products-intro p {
    margin: 0.75rem 0 0;
    color: var(--text-secondary);
    font-size: clamp(1rem, 1.45vw, 1.125rem);
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 2vw, 1.75rem);
  }

  @media (max-width: 47.999rem) {
    .products-content {
      padding-bottom: 4rem;
    }

    .products-intro {
      padding-block: 2rem 2.25rem;
      text-align: center;
    }

    .category-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
  }
</style>
