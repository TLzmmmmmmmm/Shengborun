---
import {
  Building2,
  Globe,
  Mail,
  MapPin,
  Phone,
  Smartphone,
} from '@lucide/astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const certificates = [
  {
    src: '/images/about/certificates/motorola-authorization-2026.jpg',
    alt: '摩托罗拉解决方案2026白金授权证书',
    organization: '摩托罗拉系统（中国）有限公司',
    label: '白金授权证书',
    width: 1144,
    height: 814,
  },
  {
    src: '/images/about/certificates/hytera-authorization-2026.jpg',
    alt: '海能达通信股份有限公司2026授权证书',
    organization: '海能达通信股份有限公司',
    label: '授权证书',
    width: 577,
    height: 800,
  },
  {
    src: '/images/about/certificates/huawei-authorization-2026.jpg',
    alt: '华为技术有限公司2026金牌经销商认证证书',
    organization: '华为技术有限公司',
    label: '金牌经销商认证证书',
    width: 565,
    height: 800,
  },
  {
    src: '/images/about/certificates/h3c-authorization-2026.jpg',
    alt: '新华三集团2026金牌代理商认证证书',
    organization: '新华三集团',
    label: '金牌代理商认证证书',
    width: 591,
    height: 836,
  },
  {
    src: '/images/about/certificates/codan-authorization-2026.jpg',
    alt: 'Codan Radio Communications 2026独家经销授权证书',
    organization: 'Codan Radio Communications',
    label: '独家经销授权证书',
    width: 448,
    height: 629,
  },
] as const;

const contactItems = [
  { icon: Building2, label: '公司名称', value: '北京盛博润通信设备有限公司', href: undefined, external: false },
  { icon: Smartphone, label: '值班电话', value: '13911733859（微信）', href: 'tel:+8613911733859', external: false },
  { icon: Mail, label: '电子邮箱', value: 'lsk777@sina.com', href: 'mailto:lsk777@sina.com', external: false },
  { icon: MapPin, label: '公司地址', value: '北京市朝阳区红军营东路8号', href: undefined, external: false },
] as const;
---

<BaseLayout
  title="关于我们"
  description="了解北京盛博润通信设备有限公司的公司发展、自主品牌、合作资质与联系方式。"
  canonicalPath="/about/"
  breadcrumbs={[{ label: '关于我们', href: '/about/' }]}
>
  <div class="about-hero">
    <div class="about-hero__content site-container">
      <div class="about-breadcrumb">
        <Breadcrumbs
          items={[
            { label: '首页', href: '/' },
            { label: '关于我们' },
          ]}
        />
      </div>

      <header class="about-header">
        <h1>关于我们</h1>
        <p>专业的通信设备与解决方案提供商，助力客户高效连接世界</p>
      </header>
    </div>
  </div>

  <section class="about-section site-container" id="company" aria-labelledby="company-heading">
    <div class="about-section__inner">
      <h2 id="company-heading">公司简介</h2>
      <div class="company-copy">
        <p>北京盛博润通信设备有限公司成立于2011年，公司立足于北京，通过多年来的不断积累，逐步成长为拥有自主品牌的对讲机、通信周边相关设备的厂家，服务于客户的通信相关领域需求。</p>
        <p>目前公司拥有“润信达”和“雷曼克斯”两个自主品牌，主要研发生产无线对讲机、宽带自组网、及其相关周边产品。在全国各地拥有上百家合作代理商，产品经过市场检验质量过硬。</p>
        <p>我公司还代理摩托罗拉、建伍、海能达等公司的无线对讲产品，以及柯顿、海格、烽火、鹤壁天海的第三、第四代国产短波电台，同时也代理华为、新华三、浪潮的ICT相关产品；通过我公司的团队合作系统集成方式满足客户的实际需求。</p>
        <p>我公司积极响应客户的需求，提供满足客户需求的完善解决方案和相关产品，秉承弱水三千只取一瓢饮的经营理念，脚踏实地回报公司员工、股东和社会。</p>
      </div>
    </div>
  </section>

  <section class="about-section about-section--muted site-container" id="qualifications" aria-labelledby="qualifications-heading">
    <div class="about-section__inner">
      <h2 id="qualifications-heading">诚信与资质</h2>
      <p class="section-intro">我们重视长期合作与规范经营，并与多家通信及 ICT 厂商保持合作关系。以下为部分 2026 年授权及资质文件。</p>
      <div class="certificate-grid">
        {certificates.map((certificate) => (
          <a class="certificate-card" href={certificate.src} target="_blank" rel="noreferrer" aria-label={`查看${certificate.alt}原图`}>
            <span class="certificate-card__image">
              <img src={certificate.src} alt={certificate.alt} width={certificate.width} height={certificate.height} loading="lazy" decoding="async" />
            </span>
            <span class="certificate-card__organization">{certificate.organization}</span>
            <span class="certificate-card__label">{certificate.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="about-section site-container" id="contact" aria-labelledby="contact-heading">
    <div class="about-section__inner">
      <h2 id="contact-heading">联系我们</h2>
      <p class="section-intro">如需了解更多产品信息或商务合作，欢迎与我们联系</p>
      <div class="contact-grid">
        {contactItems.map((item) => {
          const Icon = item.icon;
          const content = (
            <>
              <Icon aria-hidden="true" size={24} stroke-width={1.8} />
              <span>
                <span class="contact-item__label">{item.label}</span>
                <span class="contact-item__value">{item.value}</span>
              </span>
            </>
          );

          return item.href ? (
            <a class="contact-item" href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noreferrer' : undefined}>
              {content}
            </a>
          ) : (
            <div class="contact-item">{content}</div>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    border-bottom: 1px solid var(--divider);
    background:
      linear-gradient(
        115deg,
        rgb(229 248 247 / 75%),
        transparent 45%
      ),
      var(--surface);
  }

  .about-hero__content {
    max-width: 100rem;
    padding-block: 1.5rem clamp(4rem, 7vw, 6rem);
  }

  .about-breadcrumb {
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .about-header {
    margin-top: 1.75rem;
    text-align: center;
  }

  .about-header h1 {
    margin: 0;
    color: var(--brand-graphite);
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .about-header p {
    margin: 0.85rem 0 0;
    color: var(--text-secondary);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
  }

  .about-section {
    padding-block: clamp(4rem, 8vw, 7rem);
    scroll-margin-top: 6rem;
  }

  .about-section--muted {
    border-block: 1px solid var(--divider);
    background: var(--surface-muted);
  }

  .about-section__inner {
    max-width: 90rem;
    margin-inline: auto;
  }

  h2 {
    margin: 0;
    padding-left: 1rem;
    border-left: 0.35rem solid var(--brand-teal-dark);
    color: var(--brand-graphite);
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .company-copy {
    display: grid;
    max-width: 64rem;
    gap: 1.1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    color: #34343a;
    font-size: clamp(1rem, 1.25vw, 1.125rem);
    line-height: 1.85;
  }

  .company-copy p,
  .section-intro,
  .company-name-en { margin: 0; }

  .section-intro {
    max-width: 57rem;
    margin-top: 1.25rem;
    color: var(--text-secondary);
    font-size: 1.0625rem;
  }

  .certificate-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(1rem, 1.6vw, 1.5rem);
    margin-top: clamp(2.25rem, 4vw, 3.5rem);
  }

  .certificate-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 0.75rem 0.75rem 1.25rem;
    border: 1px solid var(--divider);
    border-radius: var(--radius-small);
    background: var(--surface);
    box-shadow: 0 0.5rem 1.5rem rgb(29 29 31 / 4%);
    color: var(--text-primary);
    text-align: center;
    text-decoration: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .certificate-card:hover {
    border-color: var(--brand-teal-dark);
    box-shadow: 0 0.85rem 2rem rgb(29 29 31 / 9%);
    color: var(--text-primary);
    transform: translateY(-0.2rem);
  }

  .certificate-card__image {
    display: grid;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    margin-bottom: 1.25rem;
    padding: 0.35rem;
    background: #fafafa;
    place-items: center;
  }

  .certificate-card__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .certificate-card__organization,
  .certificate-card__label { display: block; }

  .certificate-card__organization {
    font-size: 0.925rem;
    font-weight: 650;
    line-height: 1.55;
  }

  .certificate-card__label {
    margin-top: 0.35rem;
    color: var(--text-secondary);
    font-size: 0.8125rem;
  }

  .company-name-en {
    margin-top: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }

  #contact {
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem clamp(2rem, 5vw, 6rem);
    margin-top: clamp(2.25rem, 4vw, 3.5rem);
  }

  .contact-item {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    min-width: 0;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--divider);
    color: var(--text-primary);
    text-decoration: none;
  }

  a.contact-item:hover { color: var(--brand-teal-dark); }

  .contact-item :global(svg) {
    margin-top: 0.2rem;
    color: var(--brand-teal-dark);
  }

  .contact-item__label,
  .contact-item__value { display: block; }

  .contact-item__label {
    margin-bottom: 0.2rem;
    color: var(--text-secondary);
    font-size: 0.8125rem;
  }

  .contact-item__value {
    overflow-wrap: anywhere;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.55;
  }

  @media (max-width: 73.999rem) {
    .certificate-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 47.999rem) {
    .about-hero__content {
      padding-block: 1.25rem 4rem;
    }

    .about-breadcrumb {
      font-size: 0.8rem;
    }

    .about-header {
      margin-top: 1.5rem;
    }

    .certificate-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap-inline: 0;
    }
  }
</style>
