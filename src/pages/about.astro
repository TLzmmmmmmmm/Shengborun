---
import {
  Building2,
  Globe,
  Mail,
  MapPin,
  Phone,
  Smartphone,
} from '@lucide/astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const contactItems = [
  { icon: Building2, label: '公司名称', value: '北京盛博润通信设备有限公司', href: undefined, external: false },
  { icon: Smartphone, label: '值班电话', value: '13911733859', href: 'tel:+8613911733859', external: false },
  { icon: Mail, label: '电子邮箱', value: 'lsk777@sina.com', href: 'mailto:lsk777@sina.com', external: false },
  { icon: MapPin, label: '公司地址', value: '北京市朝阳区红军营东路8号', href: undefined, external: false },
] as const;
---

<BaseLayout
  title="关于我们｜北京盛博润通信设备有限公司"
  description="了解北京盛博润通信设备有限公司的公司简介、合作伙伴、授权资质、业务能力与联系方式。"
  canonicalPath="/about/"
  breadcrumbs={[{ label: '关于我们', href: '/about/' }]}
>
  <div class="about-hero">
    <div class="about-hero__content site-container">
      <div class="about-breadcrumb">
        <Breadcrumbs
          items={[
            { label: '首页', href: '/' },
            { label: '关于我们' },
          ]}
        />
      </div>

      <header class="about-header">
        <h1>关于我们</h1>
        <p>专业的通信设备与解决方案提供商，助力客户高效连接世界</p>
      </header>
    </div>
  </div>

  <section class="about-section site-container" id="company" aria-labelledby="company-heading">
    <div class="about-section__inner">
      <h2 id="company-heading">公司简介</h2>
      <div class="company-copy">
        <p>北京盛博润通信设备有限公司成立于2011年，公司立足于北京，专注于政府和企事业单位的通信行业需求，提供从设计、工程实施、网络优化、日常运维、通信保障等一站式服务。</p>
        <p>公司汇聚通信行业的专业人才，聚焦国内外行业先进技术和创新理念，主要研发生产无线对讲机、宽带自组网、及其相关周边产品。</p>
        <p>除经营自主研发的产品外，我们同国内外主要通信行业厂家建立密切联系，凝聚了一批经验丰富、技术过硬的技术支持团队和工程实施团队，为客户提供丰富的系统集成服务，快速响应客户的各类需求，为客户的网络保驾护航。</p>
        <p>我公司积极响应客户的需求，提供满足客户需求的完善解决方案和相关产品，秉承弱水三千只取一瓢饮的经营理念，脚踏实地回报公司员工、股东和社会。</p>
      </div>
    </div>
  </section>

  <section class="about-section site-container" id="contact" aria-labelledby="contact-heading">
    <div class="about-section__inner">
      <h2 id="contact-heading">联系我们</h2>
      <p class="section-intro">如需了解更多产品信息或商务合作，欢迎与我们联系</p>
      <div class="contact-grid">
        {contactItems.map((item) => {
          const Icon = item.icon;
          const content = (
            <>
              <Icon aria-hidden="true" size={24} stroke-width={1.8} />
              <span>
                <span class="contact-item__label">{item.label}</span>
                <span class="contact-item__value">{item.value}</span>
              </span>
            </>
          );

          return item.href ? (
            <a class="contact-item" href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noreferrer' : undefined}>
              {content}
            </a>
          ) : (
            <div class="contact-item">{content}</div>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    border-bottom: 1px solid var(--divider);
    background:
      linear-gradient(
        115deg,
        rgb(229 248 247 / 75%),
        transparent 45%
      ),
      var(--surface);
  }

  .about-hero__content {
    max-width: 100rem;
    padding-block: 1.5rem clamp(4rem, 7vw, 6rem);
  }

  .about-breadcrumb {
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .about-header {
    margin-top: 1.75rem;
    text-align: center;
  }

  .about-header h1 {
    margin: 0;
    color: var(--brand-graphite);
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .about-header p {
    margin: 0.85rem 0 0;
    color: var(--text-secondary);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
  }

  .about-section {
    padding-block: clamp(2.5rem, 4vw, 4rem);
    scroll-margin-top: 6rem;
  }

  .about-section--muted {
    border-block: 1px solid var(--divider);
    background: var(--surface-muted);
  }

  .about-section__inner {
    max-width: 90rem;
    margin-inline: auto;
  }

  h2 {
    margin: 0;
    padding-left: 1rem;
    border-left: 0.35rem solid var(--brand-teal-dark);
    color: var(--brand-graphite);
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .company-copy {
    display: grid;
    max-width: 64rem;
    gap: 1.1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    color: #34343a;
    font-size: clamp(1rem, 1.25vw, 1.125rem);
    line-height: 1.85;
  }

  .company-copy p,
  .section-intro,
  .company-name-en { margin: 0; }

  .section-intro {
    max-width: 57rem;
    margin-top: 1.25rem;
    color: var(--text-secondary);
    font-size: 1.0625rem;
  }

  .certificate-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(1rem, 1.6vw, 1.5rem);
    margin-top: clamp(2.25rem, 4vw, 3.5rem);
  }

  .certificate-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 0.75rem 0.75rem 1.25rem;
    border: 1px solid var(--divider);
    border-radius: var(--radius-small);
    background: var(--surface);
    box-shadow: 0 0.5rem 1.5rem rgb(29 29 31 / 4%);
    color: var(--text-primary);
    text-align: center;
    text-decoration: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .certificate-card:hover {
    border-color: var(--brand-teal-dark);
    box-shadow: 0 0.85rem 2rem rgb(29 29 31 / 9%);
    color: var(--text-primary);
    transform: translateY(-0.2rem);
  }

  .certificate-card__image {
    display: grid;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    margin-bottom: 1.25rem;
    padding: 0.35rem;
    background: #fafafa;
    place-items: center;
  }

  .certificate-card__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .certificate-card__organization,
  .certificate-card__label { display: block; }

  .certificate-card__organization {
    font-size: 0.925rem;
    font-weight: 650;
    line-height: 1.55;
  }

  .certificate-card__label {
    margin-top: 0.35rem;
    color: var(--text-secondary);
    font-size: 0.8125rem;
  }

  .company-name-en {
    margin-top: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem clamp(2rem, 5vw, 6rem);
    margin-top: clamp(2.25rem, 4vw, 3.5rem);
  }

  .contact-item {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    min-width: 0;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--divider);
    color: var(--text-primary);
    text-decoration: none;
  }

  a.contact-item:hover { color: var(--brand-teal-dark); }

  .contact-item :global(svg) {
    margin-top: 0.2rem;
    color: var(--brand-teal-dark);
  }

  .contact-item__label,
  .contact-item__value { display: block; }

  .contact-item__label {
    margin-bottom: 0.2rem;
    color: var(--text-secondary);
    font-size: 0.8125rem;
  }

  .contact-item__value {
    overflow-wrap: anywhere;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.55;
  }

  @media (max-width: 73.999rem) {
    .certificate-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 47.999rem) {
    .about-hero__content {
      padding-block: 1.25rem 4rem;
    }

    .about-breadcrumb {
      font-size: 0.8rem;
    }

    .about-header {
      margin-top: 1.5rem;
    }

    .certificate-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap-inline: 0;
    }
  }
</style>
