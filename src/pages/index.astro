---
import {
  ArrowRight,
  Building2,
  FilePenLine,
  GraduationCap,
  Headphones,
  HeartHandshake,
  Layers,
  Network,
  ShieldCheck,
  UserRound,
  Wrench,
} from '@lucide/astro';

import BaseLayout from '../layouts/BaseLayout.astro';
import {
  heroBenefits,
  productCategories,
  reasons,
  solutions,
  supportItems,
} from '../data/homepage';

const pageTitle = '北京盛博润通信设备有限公司';
const pageDescription = '盛博润提供专业通信设备、行业解决方案与全周期技术服务，保障关键通信稳定可靠';

const iconMap = {
  building: Building2,
  'file-pen': FilePenLine,
  'graduation-cap': GraduationCap,
  headphones: Headphones,
  'heart-handshake': HeartHandshake,
  layers: Layers,
  network: Network,
  shield: ShieldCheck,
  'shield-check': ShieldCheck,
  'user-round': UserRound,
  wrench: Wrench,
} as const;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/"
  image="/images/home/hero.png"
>
  <div class="home-page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-inner site-container">
        <div class="hero-copy">
          <p class="hero-kicker">专业通信设备与解决方案</p>
          <h1 id="hero-title">让关键通信始终<span>可靠</span></h1>
          <p class="hero-description">
            提供高可靠对讲机通信、短波通信、自组网通信和 ICT 集成服务，保障关键场景中的稳定互联
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="/products/">
              产品中心 <ArrowRight aria-hidden="true" size={18} stroke-width={2} />
            </a>
            <a class="button button-secondary" href="/solutions/">
              解决方案 <ArrowRight aria-hidden="true" size={18} stroke-width={2} />
            </a>
          </div>
        </div>

        <div class="hero-benefits" aria-label="服务优势">
          {
            heroBenefits.map((item) => {
              const Icon = iconMap[item.icon as keyof typeof iconMap];
              return (
                <div class="hero-benefit">
                  <Icon aria-hidden="true" size={20} stroke-width={1.7} />
                  <span>{item.name}</span>
                </div>
              );
            })
          }
        </div>
      </div>
    </section>

    <section class="home-section products-section" aria-labelledby="products-title">
      <div class="site-container section-container">
        <div class="section-heading">
          <h2 id="products-title">产品中心</h2>
          <a href="/products/">查看全部产品 <ArrowRight aria-hidden="true" size={18} /></a>
        </div>
        <div class="card-grid">
          {
            productCategories.map((item) => (
              <article class="image-card">
                <a class="image-card-link" href={item.href} aria-label={`查看${item.name}`}>
                  <img src={item.image} alt={item.imageAlt} loading="lazy" decoding="async" />
                  <div class="image-card-content">
                    <h3>{item.name}</h3>
                    <p>{item.description}</p>
                    <span>查看更多 <ArrowRight aria-hidden="true" size={17} /></span>
                  </div>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-section solutions-section" aria-labelledby="solutions-title">
      <div class="site-container section-container">
        <div class="section-heading">
          <h2 id="solutions-title">行业解决方案</h2>
          <a href="/solutions/">查看全部方案 <ArrowRight aria-hidden="true" size={18} /></a>
        </div>
        <div class="card-grid">
          {
            solutions.map((item) => (
              <article class="image-card">
                <a class="image-card-link" href={item.href} aria-label={`查看${item.name}解决方案`}>
                  <img src={item.image} width="1456" height="1080" alt={item.imageAlt} loading="lazy" decoding="async" />
                  <div class="image-card-content">
                    <h3>{item.name}</h3>
                    <p>{item.description}</p>
                    <span>查看方案 <ArrowRight aria-hidden="true" size={17} /></span>
                  </div>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="support-section" aria-labelledby="support-title">
      <div class="site-container section-container">
        <div class="centered-heading">
          <h2 id="support-title">技术支持</h2>
            <p>专业服务，全程保障</p>
        </div>
        <div class="support-grid">
          {
            supportItems.map((item, index) => {
              const Icon = iconMap[item.icon as keyof typeof iconMap];
              return (
                <article class="support-item">
                  <span class="support-number">{String(index + 1)}</span>
                  <div class="support-icon"><Icon aria-hidden="true" size={43} stroke-width={1.55} /></div>
                  <h3>{item.name}</h3>
                  <p>{item.description}</p>
                  <a href={item.href}>了解详情 <ArrowRight aria-hidden="true" size={17} /></a>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

    <section class="reasons-section" aria-labelledby="reasons-title">
      <div class="site-container section-container">
        <div class="centered-heading reasons-heading">
          <h2 id="reasons-title">为什么选择盛博润</h2>
          <p>以专业经验、可靠产品和全周期服务，为客户构建稳定高效的通信体系</p>
        </div>
        <div class="reasons-grid">
          {
            reasons.map((item) => {
              const Icon = iconMap[item.icon as keyof typeof iconMap];
              return (
                <article class="reason-card">
                  <Icon aria-hidden="true" size={50} stroke-width={1.5} />
                  <h3>{item.name}</h3>
                  <p>{item.description}</p>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

    <section class="cta-section" aria-labelledby="cta-title">
      <div class="site-container cta-container">
        <div class="cta-panel">
          <div class="cta-copy">
            <h2 id="cta-title">需要通信方案或产品选型支持？</h2>
            <p>联系我们的专家团队，我们将为您提供专业建议与定制化方案</p>
            <a class="button button-primary" href="/about/#contact">
              联系我们 <ArrowRight aria-hidden="true" size={18} />
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-page { overflow: hidden; background: #fff; }
  .section-container { max-width: 100rem; }
  .hero {
    position: relative;
    min-height: clamp(27rem, 36vw, 36rem);
    background-image:
      linear-gradient(
        90deg,
        rgb(244 250 253 / 96%) 0%,
        rgb(244 250 253 / 84%) 30%,
        rgb(244 250 253 / 15%) 52%,
        transparent 72%
      ),
      url('/images/home/hero.png');
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }
  .hero-inner {
    display: flex;
    min-height: inherit;
    max-width: 100rem;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(4rem, 7vw, 6rem) 2rem;
  }
  .hero-copy {
    width: min(41rem, 55%);
    padding-bottom: 5.5rem;
    transform: translateY(-2rem);
  }
  .hero-kicker {
    margin: 0 0 .8rem;
    color: var(--brand-graphite);
    font-size: clamp(1.15rem, 1.8vw, 1.55rem);
    font-weight: 700;
  }
  h1, h2, h3, p { margin-top: 0; }
  h1 {
    margin-bottom: 1rem;
    color: #061b37;
    font-size: clamp(2.4rem, 4.6vw, 4.4rem);
    letter-spacing: -.045em;
    line-height: 1.12;
  }
  h1 span { color: var(--brand-teal); }
  .hero-description {
    max-width: 37rem;
    margin-bottom: 1.75rem;
    color: #33465b;
    font-size: clamp(1rem, 1.4vw, 1.16rem);
    line-height: 1.85;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .85rem; }
  .button {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: .45rem;
    padding: .7rem 1.35rem;
    border: 1px solid transparent;
    border-radius: .35rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
  }
  .button:hover { transform: translateY(-1px); }
  .button-primary { background: var(--brand-teal); color: #fff; }
  .button-primary:hover { background: var(--brand-teal-dark); color: #fff; }
  .button-secondary { border-color: var(--brand-teal); background: rgb(255 255 255 / 78%); color: var(--brand-teal-dark); }
  .button-secondary:hover { background: #fff; color: var(--brand-graphite); }
  .hero-benefits {
    position: absolute;
    bottom: 1.75rem;
    left: max(var(--page-gutter), calc((100vw - 100rem) / 2 + var(--page-gutter)));
    display: grid;
    width: min(24rem, calc(100% - 2 * var(--page-gutter)));
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2.0rem;
  }
  .hero-benefit { display: flex; align-items: center; gap: .45rem; color: #16354f; font-size: .93rem; font-weight: 700; }
  .hero-benefit :global(svg) { flex: 0 0 auto; color: var(--brand-teal); }
  .home-section, .support-section, .reasons-section { padding-block: clamp(3.75rem, 6vw, 5.5rem); }
  .products-section {
    padding-top: clamp(2rem, 3vw, 4rem);
  }
  .solutions-section { padding-top: 0; }
  .section-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.6rem; }
  .section-heading h2, .centered-heading h2, .cta-copy h2 {
    margin-bottom: 0;
    color: #071d39;
    font-size: clamp(1.75rem, 2.6vw, 2.35rem);
    letter-spacing: -.035em;
    line-height: 1.2;
  }
  .section-heading a {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    color: var(--brand-teal-dark);
    font-weight: 700;
    text-decoration: none;
  }
  .section-heading a:hover { color: var(--brand-graphite); }
  .card-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(1rem, 1.8vw, 1.5rem); }
  .image-card {
    overflow: hidden;
    border: 1px solid #dce4ea;
    border-radius: .5rem;
    background: #fff;
    box-shadow: 0 .45rem 1.4rem rgb(15 41 65 / 5%);
    transition: box-shadow var(--transition-fast), transform var(--transition-fast);
  }
  .image-card:hover { box-shadow: 0 .8rem 2rem rgb(15 41 65 / 11%); transform: translateY(-3px); }
  .image-card-link { display: flex; height: 100%; flex-direction: column; color: inherit; text-decoration: none; }
  .image-card img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; }
  .image-card-content { display: flex; min-height: 11rem; flex: 1; flex-direction: column; padding: 1.25rem 1.25rem 1.35rem; }
  .image-card h3, .support-item h3, .reason-card h3 { margin-bottom: .75rem; color: #0b213d; font-size: 1.2rem; line-height: 1.35; }
  .image-card p, .support-item p, .reason-card p { margin-bottom: 1rem; color: var(--text-secondary); font-size: .95rem; line-height: 1.75; }
  .image-card-content span, .support-item a {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    margin-top: auto;
    color: var(--brand-teal-dark);
    font-weight: 700;
    text-decoration: none;
  }
  .support-section { border-top: 1px solid #e4ebef; border-bottom: 1px solid #e4ebef; background: #fff; }
  .centered-heading { margin-bottom: clamp(2.5rem, 4vw, 3.75rem); text-align: center; }
  .centered-heading > p {
    margin: .65rem 0 0;
    color: var(--brand-teal-dark);
    font-size: .95rem;
    font-weight: 600;
    letter-spacing: .04em;
  }
  .support-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(2.5rem, 6vw, 6rem); }
  .support-item { position: relative; display: flex; align-items: center; flex-direction: column; text-align: center; }
  .support-item:not(:last-child)::after {
    position: absolute;
    top: 1.3rem;
    left: calc(50% + 2.5rem);
    width: calc(100% + clamp(2.5rem, 6vw, 6rem) - 5rem);
    height: 1px;
    background: #a8d9dd;
    content: '';
  }
  .support-number {
    position: relative;
    z-index: 1;
    display: grid;
    width: 2.65rem;
    height: 2.65rem;
    place-items: center;
    border-radius: 50%;
    background: var(--brand-teal);
    color: #fff;
    font-size: 1.0rem;
    font-weight: 800;
  }
  .support-icon { display: grid; width: 4.5rem; height: 4.5rem; margin: 1.1rem 0 .7rem; place-items: center; color: var(--brand-teal); }
  .support-item p { max-width: 18rem; margin-bottom: .75rem; }
  .reasons-section { padding-bottom: clamp(2.75rem, 4vw, 3.5rem); background: linear-gradient(180deg, #f2fafb 0%, #f8fcfc 100%); }
  .reasons-heading { margin-bottom: 1.8rem; }
  .reasons-heading p { max-width: 52rem; margin: .7rem auto 0; color: var(--text-secondary); font-size: .95rem; font-weight: 500; line-height: 1.6;}
  .reasons-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.5rem); }
  .reason-card { min-height: 13rem; padding: 2.1rem 1.5rem 1.75rem; border: 1px solid #d7e6e8; border-radius: .5rem; background: rgb(255 255 255 / 78%); text-align: center; }
  .reason-card :global(svg) { margin-inline: auto; color: var(--brand-teal); }
  .reason-card h3 { margin-top: 1rem; }
  .reason-card p { max-width: 15rem; margin-inline: auto; }
  .cta-section {
    background: linear-gradient(180deg, #f8fcfc 0%, #f2fafb 100%);
    padding-block: 0 3.5rem;
  }

  .cta-container {
    max-width: 100rem;
  }
  .cta-panel {
    min-height: 13.5rem;
    padding: clamp(2rem, 4vw, 3.25rem);
    border: 1px solid #e3eef0;
    border-radius: .6rem;
    background-image:
      linear-gradient(
        90deg,
        rgb(245 252 254 / 97%) 0%,
        rgb(245 252 254 / 88%) 40%,
        rgb(245 252 254 / 10%) 72%
      ),
      url('/images/home/cta.png');
    background-position: center;
    background-size: cover;
  }
  .cta-copy { max-width: 39rem; }
  .cta-copy p { margin: .8rem 0 1.35rem; color: #3c4f61; line-height: 1.75; }

  @media (max-width: 74.999rem) {
    .card-grid, .reasons-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 55.999rem) {
    .hero {
      min-height: 34.2rem;
      background-image: linear-gradient(90deg, rgb(244 250 253 / 98%) 0%, rgb(244 250 253 / 88%) 55%, rgb(244 250 253 / 35%) 100%), url('/images/home/hero.png');
      background-position: 62% center;
    }
    .hero-copy { width: min(35rem, 75%); }
    .hero-benefits { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .support-grid { gap: 1.5rem; }
    .support-item:not(:last-child)::after { display: none; }
  }
  @media (max-width: 47.999rem) {
    .hero {
      min-height: auto;
      background-image:
        linear-gradient(
          180deg,
          rgb(244 250 253 / 94%) 0%,
          rgb(244 250 253 / 85%) 50%,
          rgb(244 250 253 / 70%) 100%
        ),
        url('/images/home/hero.png');
      background-position: 66% center;
    }

    .hero-inner {
      justify-content: flex-start;
      padding-block: 2.75rem 1.75rem;
    }

    .hero-copy {
      width: 100%;
      padding-bottom: 0;
      transform: none;
    }

    .hero-actions {
      align-items: flex-start;
      flex-direction: row;
      flex-wrap: wrap;
    }

    .button {
      width: auto;
    }

    .hero-benefits {
      position: static;
      width: 100%;
      margin-top: 2.5rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .8rem 1rem;
    }

    .hero-benefit {
      font-size: .85rem;
    }
    .home-section, .support-section { padding-block: 3.25rem; }
    .support-section {margin-inline: 2rem}
    .solutions-section { padding-top: 0; }
    .section-heading { align-items: flex-start; }
    .section-heading a { padding-top: .35rem; font-size: .88rem; }
    .image-card img {
      aspect-ratio: 16 / 9;
    }

    .image-card-link {
      height: auto;
    }

    .image-card-content {
      min-height: auto;
      flex: initial;
    }
    .card-grid, .support-grid, .reasons-grid { grid-template-columns: minmax(0, 1fr); }
    .image-card-content { min-height: auto; }
    .support-grid {
      gap: 1.75rem;
    }

    .support-item {
      display: grid;
      grid-template-columns: max-content 2.5rem minmax(0, 1fr);
      grid-template-areas:
        "title icon ."
        "description description description"
        "link link link";
      gap: 0.4rem 0.65rem;
      align-items: center;
      padding: 0;
      text-align: left;
    }

    .support-number {
      display: none;
    }

    .support-icon {
      grid-area: icon;
      display: grid;
      width: 2.5rem;
      height: 2.5rem;
      margin: 0;
      place-items: center;
      color: var(--brand-teal);
    }

    .support-icon :global(svg) {
      width: 2rem;
      height: 2rem;
    }

    .support-item h3 {
      grid-area: title;
      margin: 0;
    }

    .support-item p {
      grid-area: description;
      max-width: none;
      margin: 0.35rem 0 0;
    }

    .support-item a {
      grid-area: link;
      margin-top: 0.25rem;
    }

    .support-item:not(:last-child)::after {
      display: none;
    }
    
    .reasons-section {
      padding-block: 2.75rem 3rem;
    }

    .reasons-heading {
      margin-bottom: 1.75rem;
    }

    .reasons-heading p {
      max-width: 28rem;
      margin-top: .6rem;
      line-height: 1.6;
    }

    .reasons-grid {
      gap: 1rem;
    }

    .reason-card {
      min-height: auto;
      padding: 1.5rem 1.25rem 1.4rem;
    }

    .reason-card :global(svg) {
      width: 2.6rem;
      height: 2.6rem;
    }

    .reason-card h3 {
      margin-top: .75rem;
      margin-bottom: .45rem;
    }

    .reason-card p {
      max-width: 19rem;
      margin: 0 auto;
      line-height: 1.65;
    }

    .cta-section { padding-block: 0 2.5rem; }
    .cta-panel {
      min-height: 16rem;
      padding: 2rem 1.35rem;
      background-image: linear-gradient(180deg, rgb(245 252 254 / 90%) 0%, rgb(245 252 254 / 80%) 48%, rgb(245 252 254 / 70%) 100%), url('/images/home/cta.png');
      background-position: 70% center;
    }
  }
</style>
