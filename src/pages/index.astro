---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = '盛博润';
const description = '盛博润通信产品、解决方案与技术支持官方网站。';
---

<BaseLayout title={title} description={description} canonicalPath="/">
  <section class="foundation-placeholder site-container">
    <div>
      <h1>{title}</h1>
      <p>网站结构与品牌框架已就绪，正式首页内容将在后续阶段完成。</p>
    </div>
  </section>
</BaseLayout>
