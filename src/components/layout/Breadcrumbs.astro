---
interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  items: Breadcrumb[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <nav class="breadcrumbs site-container" aria-label="面包屑">
      <ol>
        {items.map((item, index) => (
          <li>
            {item.href && index < items.length - 1 ? (
              <a href={item.href}>{item.label}</a>
            ) : (
              <span aria-current={index === items.length - 1 ? 'page' : undefined}>
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .breadcrumbs {
    padding-block: 1rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li:not(:last-child)::after {
    margin-left: 0.35rem;
    color: var(--border);
    content: '/';
  }

  a {
    color: inherit;
  }
</style>
