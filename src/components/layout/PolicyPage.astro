---
import Breadcrumbs from './Breadcrumbs.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface PolicySection { id: string; label: string; }
interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  effectiveDate: string;
  updatedDate: string;
  summary: string;
  sections: readonly PolicySection[];
}

const { title, description, canonicalPath, effectiveDate, updatedDate, summary, sections } = Astro.props;
---

<BaseLayout
  title={`${title} - 北京盛博润通信设备有限公司`}
  description={description}
  canonicalPath={canonicalPath}
  breadcrumbs={[{ label: title, href: canonicalPath }]}
>
  <header class="policy-hero">
    <div class="site-container policy-hero__inner">
      <Breadcrumbs items={[{ label: '首页', href: '/' }, { label: title }]} />
      <div class="policy-hero__heading">
        <h1>{title}</h1>
        <p class="policy-summary">{summary}</p>
        <dl class="policy-dates">
          <div><dt>生效日期</dt><dd>{effectiveDate}</dd></div>
          <div><dt>最后更新</dt><dd>{updatedDate}</dd></div>
        </dl>
      </div>
    </div>
  </header>

  <div class="site-container policy-shell">
    <article class="policy-content"><slot /></article>
  </div>
</BaseLayout>

<style>
  .policy-hero {
    border-bottom: 1px solid var(--divider);
    background: radial-gradient(circle at 76% 20%, rgb(0 183 181 / 13%), transparent 27rem), linear-gradient(135deg, #f7fbfb, #fff 58%);
  }
  .policy-hero__inner { max-width: 100rem; padding-block: 1.5rem clamp(3.5rem, 7vw, 6.5rem); }
  .policy-hero__heading { max-width: 58rem; margin-top: clamp(2.75rem, 6vw, 5rem); }
  .policy-kicker { margin: 0 0 .75rem; color: var(--brand-teal-dark); font-size: .75rem; font-weight: 750; letter-spacing: .14em; }
  h1 { margin: 0; color: var(--brand-graphite); font-size: clamp(2.5rem, 5vw, 4.5rem); letter-spacing: -.045em; line-height: 1.05; }
  .policy-summary { max-width: 47rem; margin: 1.35rem 0 0; color: var(--text-secondary); font-size: clamp(1rem, 1.4vw, 1.125rem); line-height: 1.8; }
  .policy-dates { display: flex; flex-wrap: wrap; gap: .75rem 2rem; margin: 2rem 0 0; }
  .policy-dates div { display: flex; gap: .6rem; }
  .policy-dates dt { color: var(--text-secondary); }
  .policy-dates dd { margin: 0; color: var(--text-primary); font-weight: 650; }
  .policy-shell { display: grid; max-width: 100rem; grid-template-columns: minmax(13rem, 16rem) minmax(0, 48rem); gap: clamp(3rem, 8vw, 8rem); justify-content: center; padding-block: clamp(3.5rem, 7vw, 7rem); }
  .policy-aside, .policy-content { min-width: 0; }
  .policy-toc { position: sticky; top: 6rem; padding: 1.25rem 0; border-block: 1px solid var(--divider); }
  .policy-toc > p { margin: 0 0 .85rem; color: var(--brand-graphite); font-size: .875rem; font-weight: 750; }
  .policy-toc ol { display: grid; gap: .15rem; margin: 0; padding: 0; list-style: none; }
  .policy-toc a { display: grid; grid-template-columns: 1.8rem minmax(0, 1fr); gap: .5rem; padding-block: .45rem; color: var(--text-secondary); font-size: .875rem; line-height: 1.45; text-decoration: none; }
  .policy-toc a:hover { color: var(--brand-teal-dark); }
  .policy-toc a span { color: var(--brand-teal-dark); font-variant-numeric: tabular-nums; }
  .policy-content { color: #34343a; }
  .policy-content :global(section) { padding-bottom: 3rem; scroll-margin-top: 6rem; }
  .policy-content :global(section + section) { padding-top: 3rem; border-top: 1px solid var(--divider); }
  .policy-content :global(h2) { margin: 0 0 1.4rem; color: var(--brand-graphite); font-size: clamp(1.55rem, 2.5vw, 2rem); letter-spacing: -.025em; line-height: 1.3; }
  .policy-content :global(h3) { margin: 2rem 0 .75rem; color: var(--brand-graphite); font-size: 1.125rem; line-height: 1.5; }
  .policy-content :global(p), .policy-content :global(li) { font-size: 1rem; line-height: 1.9; }
  .policy-content :global(p) { margin: 0 0 1rem; }
  .policy-content :global(ul) { display: grid; gap: .5rem; margin: 1rem 0 1.25rem; padding-left: 1.35rem; }
  .policy-content :global(a) { overflow-wrap: anywhere; font-weight: 600; }
  .policy-content :global(.policy-note) { margin-top: 1.5rem; padding: 1.2rem 1.35rem; border-left: .25rem solid var(--brand-teal-dark); background: var(--brand-teal-soft); color: var(--brand-graphite); }
  .policy-content :global(.contact-card) { display: grid; gap: .65rem; margin-top: 1.5rem; padding: clamp(1.25rem, 3vw, 2rem); border: 1px solid var(--divider); border-radius: var(--radius-medium); background: var(--surface-muted); }
  .policy-content :global(.contact-card p) { display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: .75rem; margin: 0; }
  .policy-content :global(.contact-card strong) { color: var(--text-secondary); font-weight: 500; }
  @media (max-width: 61.999rem) {
    .policy-shell { grid-template-columns: 1fr; gap: 2.5rem; }
    .policy-toc { position: static; }
    .policy-toc ol { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1.5rem; }
  }
  @media (max-width: 47.999rem) {
    .policy-hero__inner { padding-block: 1.25rem 3.75rem; }
    .policy-hero__heading { margin-top: 2.75rem; }
    .policy-dates { display: grid; gap: .35rem; }
    .policy-shell { padding-block: 2.5rem 4rem; }
    .policy-toc ol { grid-template-columns: 1fr; }
    .policy-content :global(section) { padding-bottom: 2.25rem; }
    .policy-content :global(section + section) { padding-top: 2.25rem; }
    .policy-content :global(.contact-card p) { grid-template-columns: 1fr; gap: .1rem; }
  }
</style>
