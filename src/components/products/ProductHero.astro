---
import type { ResolvedProductFeature } from '../../lib/product-features';
import ProductFeatureList from './ProductFeatureList.astro';

interface Props {
  name: string;
  description?: string;
  coverImage: string;
  features: ResolvedProductFeature[];
}

const { name, description, coverImage, features } = Astro.props;
---

<section class="product-hero" data-product-hero>
  <div class="product-media" data-product-media>
    <img data-product-cover src={coverImage} alt={`${name} 产品图`} />
  </div>
  <div class="product-info" data-product-info>
    <h1>{name}</h1>
    {description && <p data-product-description>{description}</p>}
    <ProductFeatureList features={features} />
  </div>
</section>

<style>
  .product-hero {
    display: grid;
    grid-template-columns: minmax(0, 48%) minmax(0, 52%);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .product-media {
    display: grid;
    aspect-ratio: 1;
    place-items: center;
    padding: clamp(1.5rem, 4vw, 4rem);
    border-radius: var(--radius-medium);
    background: var(--surface-muted);
  }

  .product-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-info {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
  }

  h1 {
    margin: 0;
    color: var(--brand-graphite);
    font-size: clamp(2rem, 4vw, 3.5rem);
    letter-spacing: -0.04em;
    line-height: 1.12;
  }

  p {
    margin: 0;
    color: var(--text-secondary);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
  }

  @media (max-width: 47.999rem) {
    .product-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
  }
</style>
