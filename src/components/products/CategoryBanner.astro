---
interface Props {
  src: string;
  alt: string;
  objectPosition?: string;
}

const { src, alt, objectPosition = 'center center' } = Astro.props;
---

<div class="category-banner-frame">
  <img
    class="category-banner"
    data-category-banner
    src={src}
    alt={alt}
    width="2172"
    height="724"
    decoding="async"
    style={`object-position: ${objectPosition}`}
  />
</div>

<style>
  .category-banner-frame {
    width: 100%;
    aspect-ratio: 3 / 1;
    overflow: hidden;
    border-radius: 0.75rem;
    box-shadow: 0 0.25rem 1rem rgb(0 0 0 / 6%);
  }

  .category-banner {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

</style>
