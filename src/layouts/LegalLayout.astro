---
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
  };
}

const { frontmatter } = Astro.props;
---

<BaseLayout
  title={`${frontmatter.title} - 北京盛博润通信设备有限公司`}
  description={frontmatter.description}
  canonicalPath="/legal/"
  breadcrumbs={[{ label: frontmatter.title, href: '/legal/' }]}
>
  <div class="legal-page site-container">
    <div class="legal-breadcrumb">
      <Breadcrumbs items={[{ label: '首页', href: '/' }, { label: frontmatter.title }]} />
    </div>
    <article class="legal-document"><slot /></article>
  </div>
</BaseLayout>

<style>
  .legal-page {
    max-width: 100rem;
    padding-block: 1.5rem clamp(4rem, 7vw, 7rem);
  }

  .legal-breadcrumb {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .legal-document {
    max-width: 58rem;
    margin-inline: auto;
    color: #333;
  }

  .legal-document :global(h1) {
    margin: 0 0 1.5rem;
    color: var(--brand-graphite);
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  .legal-document :global(h2) {
    margin: 3.5rem 0 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--divider);
    color: var(--brand-graphite);
    font-size: clamp(1.5rem, 2.4vw, 1.875rem);
    letter-spacing: -0.02em;
    line-height: 1.4;
  }

  .legal-document :global(h3) {
    margin: 2.25rem 0 1rem;
    color: var(--brand-graphite);
    font-size: clamp(1.125rem, 1.8vw, 1.25rem);
    line-height: 1.5;
  }

  .legal-document :global(p),
  .legal-document :global(li) {
    font-size: 1rem;
    line-height: 1.9;
  }

  .legal-document :global(p) {
    margin: 0 0 1rem;
    white-space: pre-line;
  }

  .legal-document :global(h1 + p) {
    margin-bottom: 2rem;
    color: var(--text-secondary);
    line-height: 1.85;
  }

  .legal-document :global(h1 + p strong) {
    color: var(--text-primary);
    font-weight: 650;
  }

  .legal-document :global(ol),
  .legal-document :global(ul) {
    display: grid;
    gap: 0.5rem;
    margin: 1rem 0 1.5rem;
    padding-left: 1.6rem;
  }

  @media (max-width: 47.999rem) {
    .legal-page {
      padding-block: 1.25rem 4rem;
    }

    .legal-breadcrumb {
      margin-bottom: 2.75rem;
    }

    .legal-document :global(h2) {
      margin-top: 2.75rem;
      padding-top: 1.75rem;
    }

    .legal-document :global(h3) {
      margin-top: 2rem;
    }
  }
</style>
